# Mapa Interactivo UCN - Variables de Entorno
# Copiar a .env y configurar valores
#
# OBLIGATORIO para compose.yaml y compose.prod.yaml
# OPCIONAL para compose.dev.yaml (tiene fallbacks)

# Base de datos (OBLIGATORIO)
DB_NAME=InteractiveMapDB
DB_USER=postgres
DB_PASSWORD=admin

# Puertos expuestos (OBLIGATORIO)
FRONTEND_PORT=3000

# Solo para desarrollo (compose.dev.yaml)
DB_PORT=5433
BACKEND_PORT=5000

# JWT - CAMBIAR EN PRODUCCION (OBLIGATORIO)
JWT_SECRET=cambiar_en_produccion
JWT_REFRESH_SECRET=cambiar_en_produccion_refresh

# Produccion (descomentar y configurar)
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
