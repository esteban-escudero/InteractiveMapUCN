# Configuración del Servidor
PORT=3001
NODE_ENV=development

# Configuración de Base de Datos (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=secret
DB_NAME=interactive_map_db

# Seguridad (JWT)
# ¡IMPORTANTE! Cambiar este secreto en producción
JWT_SECRET=cambiar_esto_por_una_cadena_larga_y_segura_en_produccion
JWT_EXPIRES_IN=7d

# Configuración de CORS
# URL del frontend permitida
CORS_ORIGIN=http://localhost:3000

# Límites de carga de archivos (Multer)
MAX_FILE_SIZE=5242880 # 5MB en bytes
